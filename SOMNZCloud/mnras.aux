\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Residual scaled biases in the mean true redshift per cell of the augmentation SOM (Section\nobreakspace  {}\ref {sec:3.1}), \(\delta _{\langle z_{\mathrm  {true}}\rangle }\), for simulated catalogues relative to the target \texttt  {Application} population. In each depth scenario, the upper map shows the \texttt  {Restriction} dataset and the lower map the \texttt  {Combination} dataset under the baseline experiment. The residuals form coherent large-scale structures across the SOM manifold, indicating systematic mismatch in the colour--redshift relation. Moving from \texttt  {Restriction} to \texttt  {Combination} reduces the mismatch in some regions, most clearly for Y1, but substantial residual structure remains, especially for Y10. White cells indicate insufficient support.\relax }}{24}{figure.caption.13}\protected@file@percent }
\newlabel{fig:11}{{11}{24}{Residual scaled biases in the mean true redshift per cell of the augmentation SOM (Section~\ref {sec:3.1}), \(\delta _{\langle z_{\mathrm {true}}\rangle }\), for simulated catalogues relative to the target \texttt {Application} population. In each depth scenario, the upper map shows the \texttt {Restriction} dataset and the lower map the \texttt {Combination} dataset under the baseline experiment. The residuals form coherent large-scale structures across the SOM manifold, indicating systematic mismatch in the colour--redshift relation. Moving from \texttt {Restriction} to \texttt {Combination} reduces the mismatch in some regions, most clearly for Y1, but substantial residual structure remains, especially for Y10. White cells indicate insufficient support.\relax }{figure.caption.13}{}}
